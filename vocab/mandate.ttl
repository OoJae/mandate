@prefix mandate: <https://oojae.github.io/mandate/ns/v1#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://oojae.github.io/mandate/ns/v1>
    a owl:Ontology ;
    dcterms:title "Mandate: likeness and voice consent vocabulary"@en ;
    dcterms:description "A vocabulary for publishing consent to render a person's likeness or voice, revoking it, and recording what was produced under it — so that the party who grants permission, the party who renders, and a third party who trusts neither can all reach the same verdict from the same graph."@en ;
    owl:versionInfo "1.1.1" ;
    owl:versionIRI <https://oojae.github.io/mandate/ns/v1/1.1.1> ;
    owl:priorVersion <https://oojae.github.io/mandate/ns/v1/1.1.0> ;
    dcterms:creator "OoJae" ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    rdfs:seeAlso <https://github.com/OoJae/mandate> .

# ---------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------

mandate:LikenessGrant
    a rdfs:Class , owl:Class ;
    rdfs:label "Likeness grant"@en ;
    rdfs:comment "Permission, published by the depicted person's own agent, to render their likeness or voice with named capabilities, for named uses, in named territories, within a validity window and a spend ceiling. A resolver MUST accept a grant only from the Knowledge Asset anchored by the address its mandate:subject names, and that address must also be the one in mandate:grantor. Identifies its subject by a declared identifier, never by biometric data."@en .

mandate:GrantState
    a rdfs:Class , owl:Class ;
    rdfs:label "Grant state assertion"@en ;
    rdfs:comment "An append-only assertion that a grant is revoked. Because the graph has no delete, assertions accumulate and anyone can write one. A state assertion counts only when the Knowledge Asset holding it was anchored by the same address that anchored the grant it refers to. Revocation is terminal: any counted revocation ends the grant for good, an “active” assertion has no effect, and renewing consent means publishing a new grant."@en .

mandate:Derivation
    a rdfs:Class , owl:Class ;
    rdfs:label "Derivation"@en ;
    rdfs:comment "A record of one produced artifact, identified by the SHA-256 of its bytes, linking it to the capability that served it and the grant that authorised it. Each derivation has its own IRI. Written and anchored before the artifact is released, so that revocation can enumerate everything produced under a grant. A verifier judges a file only by derivations anchored by producers it trusts."@en .

mandate:Refusal
    a rdfs:Class , owl:Class ;
    rdfs:label "Refusal"@en ;
    rdfs:comment "A record that a render was refused, naming the clause that denied it and the spend it avoided. Producing a refusal never invokes the refused capability. Defined for integrators; the reference implementation does not publish refusals."@en .

# ---------------------------------------------------------------------------
# LikenessGrant properties
# ---------------------------------------------------------------------------

mandate:grantor
    a rdf:Property ;
    rdfs:label "grantor"@en ;
    rdfs:comment "The agent DID of the grantor, did:dkg:agent:0x<address>. Descriptive: a resolver checks it against the address that anchored the grant and rejects the grant if they differ."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range rdfs:Resource .

mandate:subject
    a rdf:Property ;
    rdfs:label "subject"@en ;
    rdfs:comment "A declared identifier for the depicted person, of the form 0x<grantor address>:<name>, so only that address can grant or revoke for it. Never derived from biometric data. Every grant and derivation linked to a subject is public and permanent, so the name should be meaningless outside the relationship."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:consentClipSha256
    a rdf:Property ;
    rdfs:label "consent clip SHA-256"@en ;
    rdfs:comment "Hex SHA-256 of the recorded consent clip. The clip itself is never published to the graph. The reference CLI writes it only when the transcript is a reading of the consent script it generated from the grant’s own terms, with nothing contradicted. A grant whose clip an operator confirmed by hand, with or without --force, carries no clip hash, and so does a grant made without a clip."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:consentTranscript
    a rdf:Property ;
    rdfs:label "consent transcript"@en ;
    rdfs:comment "Transcript of the spoken consent. Publishing it makes a person's own words permanent and public, so the reference implementation refuses to write it unless explicitly asked; publish mandate:consentClipSha256 instead."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:permitsCapability
    a rdf:Property ;
    rdfs:label "permits capability"@en ;
    rdfs:comment "An exact media capability name the grant permits. Matched exactly, never by family or prefix."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:permitsUseClass
    a rdf:Property ;
    rdfs:label "permits use class"@en ;
    rdfs:comment "A use class the grant permits, such as advertising. If any are present, unlisted uses are refused. The reference gate refuses a request whose declared use-class label is on its deny list (adult, sexual, deceptive-impersonation and synonyms) whatever a grant says. That is a check on the label the producer declares; nothing inspects the prompt or the media."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:forbidsUseClass
    a rdf:Property ;
    rdfs:label "forbids use class"@en ;
    rdfs:comment "A use class the grant explicitly forbids. A forbid always overrides a permit."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:territory
    a rdf:Property ;
    rdfs:label "territory"@en ;
    rdfs:comment "An ISO 3166-1 alpha-2 territory the grant covers. No territories means unrestricted."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:validFrom
    a rdf:Property ;
    rdfs:label "valid from"@en ;
    rdfs:comment "Start of the validity window, an xsd:dateTime with an explicit Z or ±hh:mm offset. Absent means no start. A value that is not a real date and time is refused by the gate and verifies TAINTED with sub-status MALFORMED."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:dateTime .

mandate:validUntil
    a rdf:Property ;
    rdfs:label "valid until"@en ;
    rdfs:comment "End of the validity window, an xsd:dateTime with an explicit Z or ±hh:mm offset, later than mandate:validFrom. Absent means no end. After it, new renders are refused, and a file rendered inside the window verifies TAINTED with sub-status EXPIRED: the grant lapsed, which is not a withdrawal of consent."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:dateTime .

mandate:maxSpendUsd
    a rdf:Property ;
    rdfs:label "maximum spend (USD)"@en ;
    rdfs:comment "Ceiling in US dollars on spend across renders authorised by this grant, summed from mandate:billedUsd on the derivations of trusted producers in the derivations graphs the gate reads. Enforced by the producer’s own gate before dispatch, in whole micro-dollars: prior spend and the estimate rounded up, the ceiling rounded down. An unknown cost, or an unreadable record from a trusted producer, under a ceiling is refused. Not a platform limit."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:decimal .

# ---------------------------------------------------------------------------
# GrantState properties
# ---------------------------------------------------------------------------

mandate:stateOf
    a rdf:Property ;
    rdfs:label "state of"@en ;
    rdfs:comment "The grant this state assertion is about. Exactly one grant IRI. Once it names a grant anchored by the same address that anchored this assertion, the assertion counts as a revocation even if its other values are malformed, and even if the same object is also typed as a grant or a derivation."@en ;
    rdfs:domain mandate:GrantState ;
    rdfs:range mandate:LikenessGrant .

mandate:state
    a rdf:Property ;
    rdfs:label "state"@en ;
    rdfs:comment "“revoked”. Any other value is treated as revoked by a fail-closed resolver; “active” has no effect."@en ;
    rdfs:domain mandate:GrantState ;
    rdfs:range xsd:string .

mandate:stateAuthor
    a rdf:Property ;
    rdfs:label "state author"@en ;
    rdfs:comment "The agent DID that wrote this state assertion. Descriptive only: anyone can write any DID here. A resolver MUST attribute a state assertion to the address that anchored its Knowledge Asset, and count it only when that address anchored the referenced grant. A stateAuthor that disagrees with the anchoring address makes the assertion malformed, and a malformed assertion by the grant’s own publisher still counts as a revocation. Version 1.0.0 of this vocabulary compared this value instead, which let a forger name the grantor."@en ;
    rdfs:domain mandate:GrantState ;
    rdfs:range rdfs:Resource .

mandate:stateAt
    a rdf:Property ;
    rdfs:label "state at"@en ;
    rdfs:comment "When the state was asserted, an xsd:dateTime with an explicit offset. Descriptive: it never decides whether a revocation counts, because revocation is terminal whatever the time it claims."@en ;
    rdfs:domain mandate:GrantState ;
    rdfs:range xsd:dateTime .

# ---------------------------------------------------------------------------
# Derivation properties
# ---------------------------------------------------------------------------

mandate:outputSha256
    a rdf:Property ;
    rdfs:label "output SHA-256"@en ;
    rdfs:comment "Hex SHA-256 of the produced artifact's bytes. The key a third party verifies against."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:servedCapability
    a rdf:Property ;
    rdfs:label "served capability"@en ;
    rdfs:comment "The capability that actually produced the artifact, which must be one the grant permits."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:servedModelId
    a rdf:Property ;
    rdfs:label "served model id"@en ;
    rdfs:comment "The provider model that served the render, when the platform reports it. Descriptive; not read by the reference verifier."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:authorizedUnder
    a rdf:Property ;
    rdfs:label "authorized under"@en ;
    rdfs:comment "The grant the producer rendered under. A verifier judges the derivation against that grant as published by the address its IRI names; a grant id published more than once is malformed."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range mandate:LikenessGrant .

mandate:loraId
    a rdf:Property ;
    rdfs:label "LoRA id"@en ;
    rdfs:comment "Identifier of a fine-tune trained under the grant, so artifacts rendered through it can be found on revocation. Written if given; not yet read by the reference resolver."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:sessionId
    a rdf:Property ;
    rdfs:label "session id"@en ;
    rdfs:comment "The render platform's job id, joining its billing records to this graph."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:billedUsd
    a rdf:Property ;
    rdfs:label "billed (USD)"@en ;
    rdfs:comment "What the render cost in US dollars: the platform’s reported cost when it gives one, otherwise a list-price estimate that does not depend on operator input, otherwise absent (unknown). Written with at most six decimals, rounded up, so a positive amount is never written as 0. Not an invoice."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:decimal .

mandate:derivedAt
    a rdf:Property ;
    rdfs:label "derived at"@en ;
    rdfs:comment "When the producer says the artifact was rendered, an xsd:dateTime with an explicit offset. Required. It is the producer’s own claim, so a verifier believes it only when it counts against the producer: a render outside the grant’s validity window."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:dateTime .

# ---------------------------------------------------------------------------
# Refusal properties
# ---------------------------------------------------------------------------

mandate:refusedCapability
    a rdf:Property ;
    rdfs:label "refused capability"@en ;
    rdfs:comment "The capability that was requested and refused."@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:string .

mandate:refusedSubject
    a rdf:Property ;
    rdfs:label "refused subject"@en ;
    rdfs:comment "The declared subject identifier the refused render was for."@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:string .

mandate:deniedByClause
    a rdf:Property ;
    rdfs:label "denied by clause"@en ;
    rdfs:comment "One of: malformed-request, use-class-prohibited, read-inconsistent, grant-exists, capability-permitted, use-class-permitted, territory-permitted, validity-window, not-revoked, spend-ceiling."@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:string .

mandate:spendAvoidedUsd
    a rdf:Property ;
    rdfs:label "spend avoided (USD)"@en ;
    rdfs:comment "What the refused render would have cost, estimated at list price. Nothing was spent: a refusal never invokes the capability."@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:decimal .

mandate:refusedAt
    a rdf:Property ;
    rdfs:label "refused at"@en ;
    rdfs:comment "When the render was refused, an xsd:dateTime with an explicit offset."@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:dateTime .
