@prefix mandate: <https://oojae.github.io/mandate/ns/v1#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://oojae.github.io/mandate/ns/v1>
    a owl:Ontology ;
    dcterms:title "Mandate: likeness and voice consent vocabulary"@en ;
    dcterms:description """A vocabulary for publishing consent to render a person's likeness or voice,
revoking it, and recording what was produced under it — so that the party who
grants permission, the party who renders, and a third party who trusts neither
can all reach the same verdict from the same graph."""@en ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://oojae.github.io/mandate/ns/v1/1.0.0> ;
    dcterms:creator "OoJae" ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    rdfs:seeAlso <https://github.com/OoJae/mandate> .

# ---------------------------------------------------------------------------
# Classes
# ---------------------------------------------------------------------------

mandate:LikenessGrant
    a rdfs:Class , owl:Class ;
    rdfs:label "Likeness grant"@en ;
    rdfs:comment """Permission, authored by the depicted person's own agent, to render their
likeness or voice with named capabilities, for named uses, in named territories,
within a validity window and a spend ceiling. Identifies its subject by a declared
identifier, never by biometric data."""@en .

mandate:GrantState
    a rdfs:Class , owl:Class ;
    rdfs:label "Grant state assertion"@en ;
    rdfs:comment """An append-only assertion that a grant is active or revoked. Because the graph
has no delete, assertions accumulate and anyone can write one. A state assertion
counts only when its mandate:stateAuthor is the mandate:grantor of the grant it
refers to; among those, the newest wins."""@en .

mandate:Derivation
    a rdfs:Class , owl:Class ;
    rdfs:label "Derivation"@en ;
    rdfs:comment """A record of one produced artifact, identified by the SHA-256 of its bytes,
linking it to the capability that served it and the grant that authorised it.
Written before the artifact is released, so that revocation can enumerate
everything produced under a grant."""@en .

mandate:Refusal
    a rdfs:Class , owl:Class ;
    rdfs:label "Refusal"@en ;
    rdfs:comment """A record that a render was refused, naming the clause that denied it and the
spend avoided. Producing a refusal never invokes the refused capability."""@en .

# ---------------------------------------------------------------------------
# LikenessGrant properties
# ---------------------------------------------------------------------------

mandate:grantor
    a rdf:Property ;
    rdfs:label "grantor"@en ;
    rdfs:comment "The agent DID that authored the grant. Must be the depicted person's own agent."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range rdfs:Resource .

mandate:subject
    a rdf:Property ;
    rdfs:label "subject"@en ;
    rdfs:comment "A declared, opaque identifier for the depicted person. Never derived from biometric data."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:consentClipSha256
    a rdf:Property ;
    rdfs:label "consent clip SHA-256"@en ;
    rdfs:comment "Hex SHA-256 of the recorded consent clip. The clip itself is never published."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:consentTranscript
    a rdf:Property ;
    rdfs:label "consent transcript"@en ;
    rdfs:comment "Optional transcript of the spoken consent, for human review against the granted scope."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:permitsCapability
    a rdf:Property ;
    rdfs:label "permits capability"@en ;
    rdfs:comment "An exact media capability name the grant permits. Matched exactly, never by family or prefix."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:permitsUseClass
    a rdf:Property ;
    rdfs:label "permits use class"@en ;
    rdfs:comment "A use class the grant permits, such as advertising. If any are present, unlisted uses are refused."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:forbidsUseClass
    a rdf:Property ;
    rdfs:label "forbids use class"@en ;
    rdfs:comment "A use class the grant explicitly forbids. A forbid always overrides a permit."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:territory
    a rdf:Property ;
    rdfs:label "territory"@en ;
    rdfs:comment "An ISO 3166-1 alpha-2 territory the grant covers. No territories means unrestricted."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:string .

mandate:validFrom
    a rdf:Property ;
    rdfs:label "valid from"@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:dateTime .

mandate:validUntil
    a rdf:Property ;
    rdfs:label "valid until"@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:dateTime .

mandate:maxSpendUsd
    a rdf:Property ;
    rdfs:label "maximum spend (USD)"@en ;
    rdfs:comment "Ceiling on total estimated spend across all renders authorised by this grant."@en ;
    rdfs:domain mandate:LikenessGrant ;
    rdfs:range xsd:decimal .

# ---------------------------------------------------------------------------
# GrantState properties
# ---------------------------------------------------------------------------

mandate:stateOf
    a rdf:Property ;
    rdfs:label "state of"@en ;
    rdfs:domain mandate:GrantState ;
    rdfs:range mandate:LikenessGrant .

mandate:state
    a rdf:Property ;
    rdfs:label "state"@en ;
    rdfs:comment "Either \"active\" or \"revoked\"."@en ;
    rdfs:domain mandate:GrantState ;
    rdfs:range xsd:string .

mandate:stateAuthor
    a rdf:Property ;
    rdfs:label "state author"@en ;
    rdfs:comment """The agent DID that wrote this state assertion. A resolver MUST ignore any state
assertion whose author is not the mandate:grantor of the referenced grant.
Without this rule, the party that profits from rendering can write its own
"active" assertion and defeat any revocation."""@en ;
    rdfs:domain mandate:GrantState ;
    rdfs:range rdfs:Resource .

mandate:stateAt
    a rdf:Property ;
    rdfs:label "state at"@en ;
    rdfs:domain mandate:GrantState ;
    rdfs:range xsd:dateTime .

# ---------------------------------------------------------------------------
# Derivation properties
# ---------------------------------------------------------------------------

mandate:outputSha256
    a rdf:Property ;
    rdfs:label "output SHA-256"@en ;
    rdfs:comment "Hex SHA-256 of the produced artifact's bytes. The key a third party verifies against."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:servedCapability
    a rdf:Property ;
    rdfs:label "served capability"@en ;
    rdfs:comment "The capability that actually produced the artifact, which must be one the grant permits."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:servedModelId
    a rdf:Property ;
    rdfs:label "served model id"@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:authorizedUnder
    a rdf:Property ;
    rdfs:label "authorized under"@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range mandate:LikenessGrant .

mandate:loraId
    a rdf:Property ;
    rdfs:label "LoRA id"@en ;
    rdfs:comment "Identifier of a fine-tune trained under the grant, so artifacts rendered through it can be found on revocation."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:sessionId
    a rdf:Property ;
    rdfs:label "session id"@en ;
    rdfs:comment "The render platform's job or session id, joining its billing records to this graph."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:string .

mandate:billedUsd
    a rdf:Property ;
    rdfs:label "billed (USD)"@en ;
    rdfs:comment "Estimated spend at list price. An estimate, not an invoice."@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:decimal .

mandate:derivedAt
    a rdf:Property ;
    rdfs:label "derived at"@en ;
    rdfs:domain mandate:Derivation ;
    rdfs:range xsd:dateTime .

# ---------------------------------------------------------------------------
# Refusal properties
# ---------------------------------------------------------------------------

mandate:refusedCapability
    a rdf:Property ;
    rdfs:label "refused capability"@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:string .

mandate:refusedSubject
    a rdf:Property ;
    rdfs:label "refused subject"@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:string .

mandate:deniedByClause
    a rdf:Property ;
    rdfs:label "denied by clause"@en ;
    rdfs:comment "One of: grant-exists, capability-permitted, use-class-permitted, territory-permitted, validity-window, not-revoked, spend-ceiling."@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:string .

mandate:spendAvoidedUsd
    a rdf:Property ;
    rdfs:label "spend avoided (USD)"@en ;
    rdfs:comment "Exact, because a refusal never invokes the capability."@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:decimal .

mandate:refusedAt
    a rdf:Property ;
    rdfs:label "refused at"@en ;
    rdfs:domain mandate:Refusal ;
    rdfs:range xsd:dateTime .
