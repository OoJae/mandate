# The public context graph grants and revocations are published to.
# Created on the grantor node, registered on-chain, subscribed by every other party.
MANDATE_GRANTS_CG=0xeD1eeB64CaC09874257F05Fd6B51A55695ad0B69/mandate-grants

# The two parties. Separate DKG_HOMEs mean separate keys: the producer never holds
# the grantor's signing key, which is what makes authorship meaningful.
MANDATE_GRANTOR_HOME=~/.dkg-mandate-grantor
MANDATE_GRANTOR_PORT=9201
MANDATE_PRODUCER_HOME=~/.dkg-mandate-producer
MANDATE_PRODUCER_PORT=9202

# Optional. The keyless Livepeer Agent demo tier works without it.
# LIVEPEER_AGENT_KEY=sk_...

# Optional. Where scratch Turtle is written before sealing. Defaults to the OS temp dir.
# MANDATE_WORK_DIR=
