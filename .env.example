# Mandate configuration. Only MANDATE_* and LIVEPEER_AGENT_KEY are read from this file.
#
# Where it is read from, in order:
#   1. the file named with --env-path <path> (every mandate command, scripts/nodes.mjs,
#      scripts/publish-skill.mjs; demo/full.mjs passes the repository's .env this way)
#   2. the file named by MANDATE_ENV_FILE
#   3. $MANDATE_HOME/.env, by default ~/.mandate/.env
# A .env in the working directory is NEVER read: a folder someone sent you must not
# be able to change which producers you trust or turn the freshness check off.
#
#   mkdir -p ~/.mandate && cp .env.example ~/.mandate/.env && chmod 600 ~/.mandate/.env
#
# The CLI warns when the file is group- or world-writable, and `mandate status` and
# `mandate verify` print which file was loaded.

# --- Context graphs -----------------------------------------------------------
# The grants graph is created and registered on-chain by the grantor node; the
# derivations graph by the producer node. Each party writes only to its own.
# Format: <owner agent address>/<name>. A graph id takes its address from the node
# that creates it, so start the nodes first (`node scripts/nodes.mjs up` works while
# these still hold the placeholders), create and register the graphs, then set them.
#
# Either variable may list several graphs, comma-separated. Readers read all of them.
# `grant` and `revoke` publish to the one grants graph namespaced under the grantor
# node's address, and derivations go to the one derivations graph under the
# producer's address; none, or more than one, is a configuration error.
MANDATE_GRANTS_CG=0x<grantor agent address>/mandate-grants
MANDATE_DERIVATIONS_CG=0x<producer agent address>/mandate-derivations

# To try the read-only path without funding anything, point a verifier node at
# the public graphs from the hackathon demo instead (Base Sepolia, on-chain
# graphs 430 and 431). You can read and verify against them; you cannot write.
# MANDATE_GRANTS_CG=0xeD1eeB64CaC09874257F05Fd6B51A55695ad0B69/mandate-grants
# MANDATE_DERIVATIONS_CG=0x8EaA4857B22dddbfb5ebC476087FEc39336e0CB5/mandate-derivations

# --- Nodes --------------------------------------------------------------------
# Separate DKG homes mean separate keys: the producer never holds the grantor's
# signing key. These are the defaults; scripts/nodes.mjs uses the same values.
MANDATE_GRANTOR_HOME=~/.dkg-mandate-grantor
MANDATE_GRANTOR_PORT=9201
MANDATE_PRODUCER_HOME=~/.dkg-mandate-producer
MANDATE_PRODUCER_PORT=9202

# A third, read-only node for `mandate verify`. It never publishes, so it needs
# no funded wallet. Without it, verify reads from the grantor's node and says so.
# Nothing checks that this port is not the producer's own node: independence is
# only as good as this setting.
MANDATE_VERIFIER_HOME=~/.dkg-mandate-verifier
MANDATE_VERIFIER_PORT=9203

# --- Trust --------------------------------------------------------------------
# Producers whose derivation edges count, comma-separated addresses. Defaults to
# the addresses the derivations graphs are namespaced under. `render --execute`
# refuses to dispatch from a producer node that is not in this list.
# MANDATE_TRUSTED_PRODUCERS=0x<producer agent address>

# --- Behaviour ----------------------------------------------------------------
# Local memory of anchors and revocations already seen, and pending renders.
# Defaults to ~/.mandate.
# MANDATE_HOME=

# Set to 0 to skip comparing each node's copy of the graphs with the chain before
# deciding. On by default: a node that is behind can miss a revocation. The check
# needs the node's admin token; without admin rights it is skipped with a warning,
# and so is the check that an empty graph id is one the node actually holds.
# MANDATE_CHECK_FRESHNESS=0

# Read limits. MANDATE_READ_MAX is the rows per query page (default 5000), and the
# most rows a discovery query may return. MANDATE_READ_MAX_ROWS is the most rows read
# from one publisher's prefix (default 250000). Past either, the read refuses
# (INCONCLUSIVE) rather than decide from part of the graph.
# MANDATE_READ_MAX=5000
# MANDATE_READ_MAX_ROWS=250000

# Set to 0 to price dry runs from the static table instead of asking Livepeer Agent.
# MANDATE_LIVE_PRICES=0

# --- Livepeer Agent -----------------------------------------------------------
# Optional. The keyless demo tier works without it. Daydream `sk_` keys were
# retired in September 2026; Livepeer Agent requires a PymtHouse composite key,
# issued to a registered developer app.
# LIVEPEER_AGENT_KEY=app_<appId>_pmth_<token>
