# The public context graph grants and revocations are published to.
# Created on the grantor node, registered on-chain, subscribed by every other party.
MANDATE_GRANTS_CG=0xeD1eeB64CaC09874257F05Fd6B51A55695ad0B69/mandate-grants

# The producer's own graph for derivation edges: what was rendered, and under
# which grant. Each party writes only to a graph it owns; verifiers read both.
MANDATE_DERIVATIONS_CG=0x8EaA4857B22dddbfb5ebC476087FEc39336e0CB5/mandate-derivations

# The two parties. Separate DKG_HOMEs mean separate keys: the producer never holds
# the grantor's signing key, which is what makes authorship meaningful.
MANDATE_GRANTOR_HOME=~/.dkg-mandate-grantor
MANDATE_GRANTOR_PORT=9201
MANDATE_PRODUCER_HOME=~/.dkg-mandate-producer
MANDATE_PRODUCER_PORT=9202

# Optional. The keyless Livepeer Agent demo tier works without it.
# Daydream `sk_` keys were retired in September 2026: Livepeer Agent now rejects
# them and requires a PymtHouse composite key, issued to a registered developer app.
# LIVEPEER_AGENT_KEY=app_<appId>_pmth_<token>

# Optional. Producers whose derivation edges count, comma-separated addresses.
# Defaults to the address the derivations graph is namespaced under.
# MANDATE_TRUSTED_PRODUCERS=0x8EaA4857B22dddbfb5ebC476087FEc39336e0CB5

# Optional. Local memory of anchors and revocations already seen, and pending renders. Defaults to ~/.mandate.
# MANDATE_HOME=

# Optional. Set to 0 to price dry runs from the static table instead of asking Livepeer Agent.
# MANDATE_LIVE_PRICES=0
