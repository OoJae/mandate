{
  "name": "mandate-consent",
  "version": "0.2.0",
  "description": "A consent rail for generative media: a producer running Mandate renders a likeness or voice only under a live grant anchored on the OriginTrail DKG by the depicted person's own agent, and anyone can verify a delivered file.",
  "license": "Apache-2.0",
  "author": "OoJae",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OoJae/mandate.git"
  },
  "homepage": "https://github.com/OoJae/mandate#readme",
  "bugs": {
    "url": "https://github.com/OoJae/mandate/issues"
  },
  "keywords": [
    "ai-agents",
    "base-sepolia",
    "consent",
    "dkg",
    "generative-media",
    "knowledge-graph",
    "likeness",
    "livepeer",
    "origintrail",
    "provenance",
    "rdf",
    "revocation"
  ],
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./dkg": "./src/dkg.mjs",
    "./resolve": "./src/resolve.mjs",
    "./verify": "./src/verify.mjs",
    "./derivation": "./src/derivation.mjs",
    "./livepeer": "./src/livepeer.mjs",
    "./consent": "./src/consent.mjs",
    "./vocab/mandate.ttl": "./vocab/mandate.ttl",
    "./vocab/context.jsonld": "./vocab/context.jsonld",
    "./package.json": "./package.json"
  },
  "bin": {
    "mandate": "./bin/mandate.mjs"
  },
  "files": [
    "src",
    "bin",
    "vocab",
    "README.md",
    "LICENSE",
    "DESIGN.md",
    ".env.example"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:mutation": "node scripts/mutation-check.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "build:vocab-docs": "node scripts/build-vocab-docs.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "spike:caps": "node spikes/s1-capabilities.mjs",
    "nodes:up": "node scripts/nodes.mjs up",
    "nodes:doctor": "node scripts/nodes.mjs doctor",
    "nodes:sync": "node scripts/nodes.mjs sync"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@origintrail-official/dkg": "^10.0.16",
    "n3": "^2.7.12"
  }
}
