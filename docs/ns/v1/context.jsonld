    },
    "territory": {
      "@id": "mandate:territory",
      "@container": "@set"
    },
    "validFrom": {
      "@id": "mandate:validFrom",
      "@type": "xsd:dateTime"
    },
    "validUntil": {
      "@id": "mandate:validUntil",
